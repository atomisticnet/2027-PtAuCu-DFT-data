#===============================================================================
# Created using the Atomic Simulation Environment (ASE)

# Tue Sep  1 03:38:04 2026

#===============================================================================
override_warning_libxc             
xc                                 libxc    MGGA_X_R2SCAN+MGGA_C_R2SCAN
atomic_solver_xc                   pbe
many_body_dispersion_nl            beta=1.23 vdw_params_kind=tssurf
relativistic                       atomic_zora scalar
sc_iter_limit                      1000
mixer                              pulay
n_max_pulay                        8
use_dipole_correction              .true.
adjust_scf                         always 2
elsi_restart                       read_and_write 50
compute_forces                     .true.
final_forces_cleaned               .true.
spin                               collinear
output                             mulliken_summary
k_grid                             4 4 1
#===============================================================================

